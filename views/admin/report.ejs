<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %> - Groom Room</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="/css/admin.css"
    >

    <style>

        body {
            background: #f5f5f5;
        }

        .report-page {
            width: 100%;
            max-width: 900px;
            margin: 30px auto;
        }

        .report-header {
            text-align: center;
            margin-bottom: 25px;
        }

        .report-header h1 {
            font-weight: 800;
            margin-bottom: 5px;
        }

        .report-header h2 {
            font-size: 22px;
            margin-bottom: 8px;
        }

        .report-date {
            color: #666;
        }

        .summary-card {
            background: #fff;
            border-radius: 14px;
            padding: 18px;
            margin-bottom: 12px;
            box-shadow: 0 2px 10px rgba(0,0,0,.06);
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
        }

        .summary-label {
            font-weight: 700;
        }

        .summary-value {
            font-size: 21px;
            font-weight: 800;
            white-space: nowrap;
        }

        .positive {
            color: #198754;
        }

        .negative {
            color: #dc3545;
        }

        .net-card {
            background: #111;
            color: #fff;
        }

        .barber-card {
            background: #fff;
            border-radius: 14px;
            padding: 20px;
            margin-top: 25px;
            box-shadow: 0 2px 10px rgba(0,0,0,.06);
        }

        .print-button {
            margin-top: 20px;
        }

        @media print {

            @page {
                size: 80mm auto;
                margin: 0;
            }

            body {
                background: #fff !important;
                margin: 0;
                padding: 0;
            }

            .navbar,
            .gr-footer,
            .no-print {
                display: none !important;
            }

            .report-page {
                width: 72mm;
                max-width: 72mm;
                margin: 0 auto;
                padding: 4mm;
            }

            .report-header {
                margin-bottom: 12px;
            }

            .report-header h1 {
                font-size: 22px;
            }

            .report-header h2 {
                font-size: 17px;
            }

            .report-date {
                font-size: 12px;
            }

            .summary-card {
                box-shadow: none;
                border-radius: 0;
                border-bottom: 1px dashed #000;
                padding: 7px 0;
                margin: 0;
            }

            .summary-label {
                font-size: 12px;
            }

            .summary-value {
                font-size: 13px;
            }

            .net-card {
                background: #fff;
                color: #000;
                border: 2px solid #000;
                margin-top: 8px;
            }

            .barber-card {
                box-shadow: none;
                border-radius: 0;
                padding: 10px 0;
                margin-top: 10px;
            }

            .barber-card h5 {
                font-size: 14px;
                text-align: center;
                margin-bottom: 8px;
            }

            table {
                width: 100%;
                font-size: 11px;
            }

            th,
            td {
                padding: 3px !important;
            }

            .print-button {
                display: none !important;
            }
        }

    </style>


<style>
/* =========================================================
   GROOM ROOM - THERMAL 80MM PRINT
   ========================================================= */
@media print {
    @page {
        size: 80mm auto;
        margin: 0;
    }

    html,
    body {
        width: 80mm !important;
        min-width: 80mm !important;
        max-width: 80mm !important;
        margin: 0 !important;
        padding: 0 !important;
        background: #fff !important;
    }

    body {
        font-family: "Cairo", "Segoe UI", Tahoma, Arial, sans-serif !important;
        color: #111 !important;
        font-size: 9px !important;
    }

    .gr-navbar,
    .gr-footer,
    .navbar,
    .filter-card,
    .filter-form,
    .quick-actions-grid,
    .print-btn,
    .print-button,
    .payroll-print-actions,
    .actions-title,
    .actions-grid,
    .no-print {
        display: none !important;
    }

    .reports-page,
    .payroll-page,
    .page-container,
    .report-page {
        width: 80mm !important;
        min-width: 80mm !important;
        max-width: 80mm !important;
        margin: 0 !important;
        padding: 4mm !important;
        box-sizing: border-box !important;
    }

    .dashboard-header,
    .page-header,
    .report-header {
        text-align: center !important;
        margin: 0 0 4mm !important;
        padding: 0 0 3mm !important;
        border-bottom: 1px dashed #111 !important;
    }

    .dashboard-header h1,
    .page-header h1,
    .report-header h1 {
        margin: 0 !important;
        font-size: 17px !important;
        font-weight: 900 !important;
    }

    .dashboard-header h3,
    .report-header h2 {
        margin: 1mm 0 !important;
        font-size: 13px !important;
    }

    .dashboard-header p,
    .page-header p,
    .report-date,
    .page-subtitle {
        margin: 0 !important;
        color: #111 !important;
        font-size: 8px !important;
    }

    .dashboard-card,
    .summary-card,
    .table-card,
    .payroll-table-card,
    .barber-card,
    .net-card {
        width: 100% !important;
        box-sizing: border-box !important;
        background: #fff !important;
        box-shadow: none !important;
        border-radius: 0 !important;
        border: 0 !important;
        margin: 0 0 3mm !important;
        padding: 2mm 0 !important;
    }

    .card-header {
        padding: 0 0 1.5mm !important;
        margin: 0 !important;
        border-bottom: 1px dashed #888 !important;
    }

    .card-header h2,
    .barber-card h5 {
        margin: 0 !important;
        font-size: 11px !important;
        font-weight: 900 !important;
    }

    .card-header p {
        margin: 1mm 0 0 !important;
        font-size: 7px !important;
    }

    /* Summary becomes a compact receipt list */
    .summary-grid,
    .reports-page .quick-actions-grid {
        display: block !important;
        margin: 0 !important;
    }

    .summary-card,
    .stat-card {
        display: flex !important;
        justify-content: space-between !important;
        align-items: center !important;
        padding: 1.3mm 0 !important;
        margin: 0 !important;
        border-radius: 0 !important;
        border-bottom: 1px dotted #888 !important;
        box-shadow: none !important;
    }

    .summary-label,
    .summary-value,
    .stat-label,
    .stat-value {
        margin: 0 !important;
        font-size: 8px !important;
        line-height: 1.25 !important;
    }

    .table-wrapper {
        overflow: visible !important;
        width: 100% !important;
    }

    table,
    .payroll-table {
        width: 100% !important;
        min-width: 0 !important;
        max-width: 100% !important;
        table-layout: fixed !important;
        border-collapse: collapse !important;
        font-size: 7px !important;
    }

    th,
    td,
    .payroll-table th,
    .payroll-table td {
        padding: 1.1mm 0.5mm !important;
        font-size: 7px !important;
        line-height: 1.25 !important;
        white-space: normal !important;
        overflow-wrap: anywhere !important;
        word-break: break-word !important;
        border-bottom: 1px dotted #888 !important;
        text-align: center !important;
    }

    th,
    .payroll-table th {
        background: #fff !important;
        font-weight: 900 !important;
    }

    .payroll-table th:first-child,
    .payroll-table td:first-child {
        text-align: right !important;
    }

    .invoice-number,
    .amount {
        white-space: normal !important;
        font-size: 7px !important;
    }

    .details-btn {
        display: none !important;
    }

    .payment-badge {
        padding: 0 !important;
        background: transparent !important;
        font-size: 7px !important;
    }

    .empty-state {
        padding: 4mm 0 !important;
        font-size: 8px !important;
    }

    /* Main reports: hide the custom filter section only, keep all report data */
    .reports-page > section:nth-child(3) {
        display: none !important;
    }

    .reports-page .dashboard-card {
        page-break-inside: avoid;
    }

    .reports-page::after,
    .payroll-page::after,
    .page-container::after,
    .report-page::after {
        content: "GROOM ROOM";
        display: block;
        text-align: center;
        margin-top: 4mm;
        padding-top: 2mm;
        border-top: 1px dashed #111;
        font-size: 8px;
        font-weight: 800;
    }
}
</style>

</head>

<body>

    <%- include('../partials/navbar', { user }) %>

    <main class="report-page">

        <div class="report-header">

            <h1>GROOM ROOM</h1>

            <h2>
                <%= title %>
            </h2>

            <div class="report-date">
                من <%= dateFrom %>
                إلى <%= dateTo %>
            </div>

        </div>


        <div class="summary-card">

            <div class="summary-row">

                <span class="summary-label">
                    إجمالي المبيعات
                </span>

                <span class="summary-value">
                    <%= Number(totalSales).toLocaleString('en-US', {
                        minimumFractionDigits: 2
                    }) %>
                    جنيه
                </span>

            </div>

        </div>


        <div class="summary-card">

            <div class="summary-row">

                <span class="summary-label">
                    عدد الفواتير
                </span>

                <span class="summary-value">
                    <%= totalInvoices %>
                </span>

            </div>

        </div>


        <div class="summary-card">

            <div class="summary-row">

                <span class="summary-label">
                    البونص
                </span>

                <span class="summary-value positive">
                    + <%= Number(totalBonuses).toLocaleString('en-US', {
                        minimumFractionDigits: 2
                    }) %>
                    جنيه
                </span>

            </div>

        </div>


        <div class="summary-card">

            <div class="summary-row">

                <span class="summary-label">
                    السلف
                </span>

                <span class="summary-value negative">
                    - <%= Number(totalAdvances).toLocaleString('en-US', {
                        minimumFractionDigits: 2
                    }) %>
                    جنيه
                </span>

            </div>

        </div>


        <div class="summary-card">

            <div class="summary-row">

                <span class="summary-label">
                    المصروفات
                </span>

                <span class="summary-value negative">
                    - <%= Number(totalExpenses).toLocaleString('en-US', {
                        minimumFractionDigits: 2
                    }) %>
                    جنيه
                </span>

            </div>

        </div>


        <div class="summary-card net-card">

            <div class="summary-row">

                <span class="summary-label">
                    صافي الدخل
                </span>

                <span class="summary-value">
                    <%= Number(netIncome).toLocaleString('en-US', {
                        minimumFractionDigits: 2
                    }) %>
                    جنيه
                </span>

            </div>

        </div>


        <div class="barber-card">

            <h5>
                مبيعات الحلاقين
            </h5>

            <% if (barberSales.length > 0) { %>

                <div class="table-responsive">

                    <table class="table table-sm align-middle">

                        <thead>

                            <tr>

                                <th>
                                    الحلاق
                                </th>

                                <th class="text-center">
                                    فواتير
                                </th>

                                <th class="text-end">
                                    المبيعات
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            <% barberSales.forEach(barber => { %>

                                <tr>

                                    <td>
                                        <%= barber.BarberName %>
                                    </td>

                                    <td class="text-center">
                                        <%= barber.InvoiceCount %>
                                    </td>

                                    <td class="text-end fw-bold">
                                        <%= Number(
                                            barber.TotalSales || 0
                                        ).toLocaleString('en-US', {
                                            minimumFractionDigits: 2
                                        }) %>
                                    </td>

                                </tr>

                            <% }); %>

                        </tbody>

                    </table>

                </div>

            <% } else { %>

                <div class="text-center text-muted">
                    لا توجد مبيعات للحلاقين خلال هذه الفترة.
                </div>

            <% } %>

        </div>


        <div class="text-center no-print print-button">

            <button
                type="button"
                class="btn btn-dark btn-lg px-5"
                onclick="window.print()"
            >
                🖨️ طباعة حرارية
            </button>

            <a
                href="/admin"
                class="btn btn-secondary btn-lg"
            >
                رجوع
            </a>

        </div>

    </main>


    <%- include('../partials/footer') %>

</body>

</html>