<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>الفواتير - GROOM ROOM</title>

    <link rel="stylesheet" href="/css/admin.css">

    <link rel="stylesheet" href="/css/professional.css">

    <style>

        body {
            background: #f5f5f5;
        }

        .page-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 30px 20px;
        }

        .page-header {
            margin-bottom: 25px;
        }

        .page-title {
            margin: 0;
            font-size: 30px;
            font-weight: 900;
        }

        .page-subtitle {
            margin-top: 8px;
            color: #777;
            font-size: 15px;
        }

        .filter-card {
            background: #fff;
            border-radius: 14px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 3px 15px rgba(0, 0, 0, 0.06);
        }

        .filter-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            align-items: end;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 7px;
        }

        .form-group label {
            font-size: 13px;
            font-weight: 700;
        }

        .form-group input,
        .form-group select {
            width: 100%;
            box-sizing: border-box;
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 11px 12px;
            font-size: 14px;
            background: #fff;
        }

        .filter-actions {
            display: flex;
            gap: 10px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: none;
            border-radius: 8px;
            padding: 11px 18px;
            text-decoration: none;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
        }

        .btn-primary {
            background: #111;
            color: #fff;
        }

        .btn-secondary {
            background: #eee;
            color: #111;
        }

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            margin-bottom: 20px;
        }

        .summary-card {
            background: #fff;
            border-radius: 14px;
            padding: 20px;
            box-shadow: 0 3px 15px rgba(0, 0, 0, 0.06);
        }

        .summary-label {
            color: #777;
            font-size: 14px;
            margin-bottom: 8px;
        }

        .summary-value {
            font-size: 27px;
            font-weight: 900;
        }

        .table-card {
            background: #fff;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 3px 15px rgba(0, 0, 0, 0.06);
        }

        .table-wrapper {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 800px;
        }

        th,
        td {
            padding: 14px 16px;
            text-align: right;
            border-bottom: 1px solid #eee;
            font-size: 14px;
        }

        th {
            background: #fafafa;
            font-weight: 900;
            white-space: nowrap;
        }

        td {
            color: #333;
        }

        tr:last-child td {
            border-bottom: none;
        }

        .invoice-number {
            font-weight: 900;
        }

        .amount {
            font-weight: 900;
            white-space: nowrap;
        }

        .payment-badge {
            display: inline-block;
            padding: 5px 9px;
            border-radius: 7px;
            background: #f0f0f0;
            font-size: 12px;
            font-weight: 700;
        }

        .details-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #111;
            color: #fff;
            text-decoration: none;
            border-radius: 7px;
            padding: 7px 12px;
            font-size: 12px;
            font-weight: 700;
        }

        .empty-state {
            text-align: center;
            padding: 50px 20px;
            color: #777;
        }

        .empty-state-icon {
            font-size: 40px;
            margin-bottom: 10px;
        }

        .print-btn {
            margin-top: 15px;
        }

        @media (max-width: 900px) {

            .filter-grid {
                grid-template-columns: repeat(2, 1fr);
            }

        }

        @media (max-width: 600px) {

            .page-container {
                padding: 20px 12px;
            }

            .page-title {
                font-size: 24px;
            }

            .filter-grid {
                grid-template-columns: 1fr;
            }

            .filter-actions {
                width: 100%;
            }

            .filter-actions .btn {
                flex: 1;
            }

            .summary-grid {
                grid-template-columns: 1fr;
            }

            .summary-value {
                font-size: 23px;
            }

        }

        @media print {

            .gr-navbar,
            .gr-footer,
            .filter-card,
            .print-btn {
                display: none !important;
            }

            body {
                background: #fff;
            }

            .page-container {
                max-width: none;
                padding: 0;
            }

            .table-card,
            .summary-card {
                box-shadow: none;
            }

        }

    </style>




<style>
/* =========================================================
   GROOM ROOM - INVOICE REPORT THERMAL 80MM
   ========================================================= */

@media print {

    @page {
        size: 80mm auto;
        margin: 0;
    }

    html,
    body {
        width: 80mm !important;
        min-width: 80mm !important;
        max-width: 80mm !important;
        margin: 0 !important;
        padding: 0 !important;
        background: #fff !important;
    }

    body {
        font-family: Arial, "Segoe UI", Tahoma, sans-serif !important;
        color: #111 !important;
        font-size: 8px !important;
    }

    .gr-navbar,
    .gr-footer,
    .filter-card,
    .filter-form,
    .print-btn,
    .print-button,
    .no-print,
    button {
        display: none !important;
    }

    .invoices-page,
    .page-container,
    .admin-dashboard {
        width: 80mm !important;
        min-width: 80mm !important;
        max-width: 80mm !important;
        margin: 0 !important;
        padding: 3mm !important;
        box-sizing: border-box !important;
    }

    .page-header,
    .dashboard-header {
        text-align: center !important;
        margin: 0 !important;
        padding: 0 0 2.5mm !important;
        border-bottom: 1px dashed #111 !important;
    }

    .page-header h1,
    .dashboard-header h1 {
        margin: 0 !important;
        font-size: 16px !important;
        font-weight: 900 !important;
    }

    .page-header p,
    .dashboard-header p {
        margin: 1mm 0 0 !important;
        font-size: 7px !important;
        color: #111 !important;
    }

    .invoice-card,
    .table-card,
    .dashboard-card {
        border: 0 !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        background: #fff !important;
        width: 100% !important;
        margin: 0 !important;
        padding: 2mm 0 !important;
    }

    table {
        width: 100% !important;
        min-width: 0 !important;
        max-width: 100% !important;
        table-layout: fixed !important;
        border-collapse: collapse !important;
        font-size: 6.5px !important;
    }

    th,
    td {
        padding: 1mm 0.4mm !important;
        font-size: 6.5px !important;
        line-height: 1.2 !important;
        white-space: normal !important;
        overflow-wrap: anywhere !important;
        word-break: break-word !important;
        border-bottom: 1px dotted #999 !important;
        text-align: center !important;
    }

    th {
        font-weight: 900 !important;
        background: #fff !important;
    }

    .invoice-number,
    .amount {
        white-space: normal !important;
    }

    .details-btn {
        display: none !important;
    }

    .invoices-page::after,
    .page-container::after,
    .admin-dashboard::after {
        content: "GROOM ROOM";
        display: block;
        text-align: center;
        margin-top: 4mm;
        padding-top: 2mm;
        border-top: 1px dashed #111;
        font-size: 7px;
        font-weight: 800;
    }
}
</style>

</head>

<body class="professional-ui">

<%- include('../partials/navbar', { user }) %>

<div class="page-container">

    <div class="page-header">

        <h1 class="page-title">
            الفواتير
        </h1>

        <div class="page-subtitle">
            عرض ومتابعة جميع الفواتير
        </div>

    </div>


    <!-- FILTERS -->

    <div class="filter-card">

        <form method="GET" action="/admin/invoices">

            <div class="filter-grid">

                <div class="form-group">

                    <label>
                        من تاريخ
                    </label>

                    <input
                        type="date"
                        name="dateFrom"
                        value="<%= dateFrom %>"
                    >

                </div>


                <div class="form-group">

                    <label>
                        إلى تاريخ
                    </label>

                    <input
                        type="date"
                        name="dateTo"
                        value="<%= dateTo %>"
                    >

                </div>


                <div class="form-group">

                    <label>
                        الحلاق
                    </label>

                    <select name="barberId">

                        <option value="">
                            كل الحلاقين
                        </option>

                        <% barbers.forEach(barber => { %>

                            <option
                                value="<%= barber.Id %>"
                                <%= String(barberId) === String(barber.Id) ? 'selected' : '' %>
                            >
                                <%= barber.Name %>
                            </option>

                        <% }) %>

                    </select>

                </div>


                <div class="filter-actions">

                    <button
                        type="submit"
                        class="btn btn-primary"
                    >
                        بحث
                    </button>

                    <a
                        href="/admin/invoices"
                        class="btn btn-secondary"
                    >
                        إعادة ضبط
                    </a>

                    <button
                        type="button"
                        class="btn btn-outline-dark invoice-print-btn"
                        onclick="window.print()"
                    >
                        🖨️ طباعة تقرير الفواتير
                    </button>

                </div>

            </div>

        </form>

    </div>


    <!-- SUMMARY -->

    <div class="summary-grid">

        <div class="summary-card">

            <div class="summary-label">
                عدد الفواتير
            </div>

            <div class="summary-value">
                <%= totalInvoices %>
            </div>

        </div>


        <div class="summary-card">

            <div class="summary-label">
                إجمالي المبيعات
            </div>

            <div class="summary-value">
                <%= Number(totalSales).toFixed(2) %> جنيه
            </div>

        </div>

    </div>


    <!-- INVOICES -->

    <div class="table-card">

        <% if (invoices && invoices.length > 0) { %>

            <div class="table-wrapper">

                <table>

                    <thead>

                        <tr>

                            <th>
                                رقم الفاتورة
                            </th>

                            <th>
                                التاريخ
                            </th>

                            <th>
                                الحلاق
                            </th>

                            <th>
                                طريقة الدفع
                            </th>

                            <th>
                                الإجمالي
                            </th>

                            <th>
                                التفاصيل
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        <% invoices.forEach(invoice => { %>

                            <tr>

                                <td>

                                    <span class="invoice-number">
                                        <%= invoice.InvoiceNumber %>
                                    </span>

                                </td>


                                <td>

                                    <%= new Date(invoice.CreatedAt).toLocaleDateString('en-GB') %>

                                    -

                                    <%= new Date(invoice.CreatedAt).toLocaleTimeString('en-GB', {
                                        hour: '2-digit',
                                        minute: '2-digit'
                                    }) %>

                                </td>


                                <td>
                                    <%= invoice.BarberName %>
                                </td>


                                <td>

                                    <span class="payment-badge">

                                        <% if (invoice.PaymentMethod === 'Cash') { %>

                                            كاش

                                        <% } else if (invoice.PaymentMethod === 'Card') { %>

                                            فيزا

                                        <% } else if (invoice.PaymentMethod === 'Wallet') { %>

                                            Wallet

                                        <% } else { %>

                                            <%= invoice.PaymentMethod %>

                                        <% } %>

                                    </span>

                                </td>


                                <td>

                                    <span class="amount">
                                        <%= Number(invoice.TotalAmount).toFixed(2) %>
                                        جنيه
                                    </span>

                                </td>


                                <td>

                                    <a
                                        href="/admin/invoices/<%= invoice.Id %>"
                                        class="details-btn"
                                    >
                                        التفاصيل
                                    </a>

                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>

        <% } else { %>

            <div class="empty-state">

                <div class="empty-state-icon">
                    🧾
                </div>

                <div>
                    مفيش فواتير مطابقة للبحث
                </div>

            </div>

        <% } %>

    </div>


    <button
        type="button"
        class="btn btn-secondary print-btn"
        onclick="window.print()"
    >
        🖨️ طباعة
    </button>

</div>


<%- include('../partials/footer') %>


<script>
document.addEventListener('DOMContentLoaded', function () {
    const params = new URLSearchParams(window.location.search);

    if (params.get('print') === '1') {
        setTimeout(function () {
            window.print();
        }, 350);
    }
});
</script>


<script>
document.addEventListener('DOMContentLoaded', function () {
    const params = new URLSearchParams(window.location.search);

    if (params.get('print') === '1') {
        setTimeout(function () {
            window.print();
        }, 500);
    }
});
</script>

</body>

</html>