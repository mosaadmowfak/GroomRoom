<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= barber && barber.Id
            ? 'تعديل حلاق'
            : 'إضافة حلاق'
        %>
        - Groom Room
    </title>

    <link
        rel="stylesheet"
        href="/css/admin.css"
    >

    <style>

        .barber-form-page {
            margin-top: 24px;
            margin-bottom: 40px;
        }

        .barber-form-header {
            margin-bottom: 24px;
        }

        .barber-form-header h1 {
            font-weight: 700;
        }

        .barber-form-card {
            background: #fff;
            border-radius: 10px;
            box-shadow:
                0 .125rem .25rem rgba(0, 0, 0, .075);
        }

        .barber-form-card-body {
            padding: 24px;
        }

        .barber-form-group {
            margin-bottom: 16px;
        }

        .barber-form-group.last {
            margin-bottom: 24px;
        }

        .barber-form-label {
            display: block;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .barber-form-control {
            width: 100%;
            box-sizing: border-box;
            min-height: 48px;
            padding: 10px 14px;
            border: 1px solid #ced4da;
            border-radius: 6px;
            background: #fff;
            font-size: 16px;
            font-family: inherit;
        }

        .barber-form-control:focus {
            outline: none;
            border-color: #212529;
            box-shadow:
                0 0 0 .15rem rgba(33, 37, 41, .12);
        }

        .barber-form-error {
            display: block;
            color: #dc3545;
            font-size: 14px;
            margin-top: 5px;
        }

        .barber-days-title {
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 16px;
        }

        .barber-days-grid {
            display: grid;
            grid-template-columns:
                repeat(3, minmax(0, 1fr));
            gap: 12px;
        }

        .barber-day {
            position: relative;
            min-height: 48px;
            padding: 12px 35px 12px 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
            box-sizing: border-box;
            cursor: pointer;
            transition:
                background .15s ease,
                border-color .15s ease;
        }

        .barber-day:hover {
            background: #f8f9fa;
        }

        .barber-day input {
            position: absolute;
            right: 12px;
            top: 15px;
            width: 17px;
            height: 17px;
            margin: 0;
            cursor: pointer;
        }

        .barber-day label {
            display: block;
            cursor: pointer;
            font-size: 15px;
        }

        .barber-form-buttons {
            display: flex;
            gap: 8px;
        }

        .barber-form-buttons .save-btn,
        .barber-form-buttons .back-btn {
            min-width: 120px;
            min-height: 48px;
            padding: 10px 20px;
            border-radius: 6px;
            font-size: 16px;
            font-family: inherit;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-sizing: border-box;
        }

        .barber-form-buttons .save-btn {
            border: 1px solid #212529;
            background: #212529;
            color: #fff;
        }

        .barber-form-buttons .save-btn:hover {
            background: #000;
            border-color: #000;
        }

        .barber-form-buttons .back-btn {
            border: 1px solid #6c757d;
            background: #6c757d;
            color: #fff;
        }

        .barber-form-buttons .back-btn:hover {
            background: #5c636a;
            border-color: #5c636a;
        }

        .form-error-summary {
            background: #fff0f0;
            color: #b42318;
            border: 1px solid #f3b5b5;
            border-radius: 8px;
            padding: 12px;
            margin-bottom: 20px;
        }

        @media (max-width: 576px) {

            .barber-form-page {
                margin-top: 20px;
                padding-left: 12px;
                padding-right: 12px;
            }

            .barber-form-header {
                margin-bottom: 25px;
            }

            .barber-form-header h1 {
                font-size: 28px;
            }

            .barber-form-header h3 {
                font-size: 21px;
            }

            .barber-form-header p {
                font-size: 14px;
            }

            .barber-form-card-body {
                padding: 20px;
            }

            .barber-days-grid {
                grid-template-columns:
                    repeat(2, minmax(0, 1fr));
            }

            .barber-form-buttons {
                flex-direction: column;
            }

            .barber-form-buttons .save-btn,
            .barber-form-buttons .back-btn {
                width: 100%;
                min-width: 0;
                min-height: 46px;
            }
        }

    </style>

</head>


<body>

    <%- include('../partials/navbar', { user: user }) %>


    <div class="admin-dashboard">

        <div class="barber-form-page">

            <div
                style="
                    display:flex;
                    justify-content:center;
                "
            >

                <div
                    style="
                        width:100%;
                        max-width:700px;
                    "
                >


                    <!-- Header -->

                    <div
                        class="text-center barber-form-header"
                    >

                        <h1>
                            GROOM ROOM
                        </h1>

                        <h3>

                            <%= barber && barber.Id
                                ? 'تعديل حلاق'
                                : 'إضافة حلاق'
                            %>

                        </h3>

                        <p class="text-muted mb-0">

                            <%= barber && barber.Id
                                ? 'تعديل بيانات الحلاق والمرتب وأيام العمل'
                                : 'إضافة حلاق جديد للنظام'
                            %>

                        </p>

                    </div>


                    <!-- Card -->

                    <div class="barber-form-card">

                        <div
                            class="barber-form-card-body"
                        >


                            <% if (error) { %>

                                <div
                                    class="form-error-summary"
                                >
                                    <%= error %>
                                </div>

                            <% } %>


                            <form
                                method="POST"
                                action="<%= barber && barber.Id
                                    ? '/admin/barbers/edit/' + barber.Id
                                    : '/admin/barbers/create'
                                %>"
                            >


                                <!-- Name -->

                                <div
                                    class="barber-form-group"
                                >

                                    <label
                                        class="barber-form-label"
                                    >
                                        اسم الحلاق
                                    </label>

                                    <input
                                        type="text"
                                        name="name"
                                        class="barber-form-control"
                                        placeholder="اكتب اسم الحلاق"
                                        value="<%= barber ? barber.Name || '' : '' %>"
                                        required
                                    >

                                </div>


                                <!-- Salary -->

                                <div
                                    class="barber-form-group"
                                >

                                    <label
                                        class="barber-form-label"
                                    >
                                        المرتب الأساسي الشهري
                                    </label>

                                    <input
                                        type="number"
                                        name="basicSalary"
                                        min="0"
                                        step="0.01"
                                        class="barber-form-control"
                                        placeholder="مثال: 9000"
                                        value="<%= barber ? barber.BasicSalary ?? '' : '' %>"
                                        required
                                    >

                                </div>


                                <!-- Start Date -->

                                <div
                                    class="barber-form-group last"
                                >

                                    <label
                                        class="barber-form-label"
                                    >
                                        تاريخ بداية العمل
                                    </label>

                                    <input
                                        type="date"
                                        name="startDate"
                                        class="barber-form-control"
                                        value="<%= barber ? barber.StartDate || '' : '' %>"
                                        required
                                    >

                                </div>


                                <!-- Working Days -->

                                <div
                                    class="barber-form-group last"
                                >

                                    <div
                                        class="barber-days-title"
                                    >
                                        أيام العمل
                                    </div>


                                    <div
                                        class="barber-days-grid"
                                    >


                                        <!-- Saturday -->

                                        <div class="barber-day">

                                            <input
                                                type="checkbox"
                                                id="saturday"
                                                name="saturday"
                                                value="1"
                                                <%= barber && barber.WorksSaturday ? 'checked' : '' %>
                                            >

                                            <label for="saturday">
                                                السبت
                                            </label>

                                        </div>


                                        <!-- Sunday -->

                                        <div class="barber-day">

                                            <input
                                                type="checkbox"
                                                id="sunday"
                                                name="sunday"
                                                value="1"
                                                <%= barber && barber.WorksSunday ? 'checked' : '' %>
                                            >

                                            <label for="sunday">
                                                الأحد
                                            </label>

                                        </div>


                                        <!-- Monday -->

                                        <div class="barber-day">

                                            <input
                                                type="checkbox"
                                                id="monday"
                                                name="monday"
                                                value="1"
                                                <%= barber && barber.WorksMonday ? 'checked' : '' %>
                                            >

                                            <label for="monday">
                                                الاثنين
                                            </label>

                                        </div>


                                        <!-- Tuesday -->

                                        <div class="barber-day">

                                            <input
                                                type="checkbox"
                                                id="tuesday"
                                                name="tuesday"
                                                value="1"
                                                <%= barber && barber.WorksTuesday ? 'checked' : '' %>
                                            >

                                            <label for="tuesday">
                                                الثلاثاء
                                            </label>

                                        </div>


                                        <!-- Wednesday -->

                                        <div class="barber-day">

                                            <input
                                                type="checkbox"
                                                id="wednesday"
                                                name="wednesday"
                                                value="1"
                                                <%= barber && barber.WorksWednesday ? 'checked' : '' %>
                                            >

                                            <label for="wednesday">
                                                الأربعاء
                                            </label>

                                        </div>


                                        <!-- Thursday -->

                                        <div class="barber-day">

                                            <input
                                                type="checkbox"
                                                id="thursday"
                                                name="thursday"
                                                value="1"
                                                <%= barber && barber.WorksThursday ? 'checked' : '' %>
                                            >

                                            <label for="thursday">
                                                الخميس
                                            </label>

                                        </div>


                                        <!-- Friday -->

                                        <div class="barber-day">

                                            <input
                                                type="checkbox"
                                                id="friday"
                                                name="friday"
                                                value="1"
                                                <%= barber && barber.WorksFriday ? 'checked' : '' %>
                                            >

                                            <label for="friday">
                                                الجمعة
                                            </label>

                                        </div>


                                    </div>

                                </div>


                                <!-- Buttons -->

                                <div
                                    class="barber-form-buttons"
                                >

                                    <button
                                        type="submit"
                                        class="save-btn"
                                    >

                                        <%= barber && barber.Id
                                            ? 'حفظ التعديلات'
                                            : 'حفظ الحلاق'
                                        %>

                                    </button>


                                    <a
                                        href="/admin/barbers"
                                        class="back-btn"
                                    >
                                        رجوع
                                    </a>

                                </div>


                            </form>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <%- include('../partials/footer') %>

</body>

</html>